              "value": "Olá! Vou te ajudar agora mesmo.",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "4d444444-dddd-4ddd-8ddd-444444444444",
      "name": "Montar Resposta Prioritaria",
